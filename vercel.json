{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/fetch_roas.mjs && python3 scripts/build_data.py && mkdir -p public/data && cp index.html public/ && cp data/bookings.json public/data/",
  "outputDirectory": "public",
  "crons": [
    {
      "path": "/api/refresh",
      "schedule": "0 11 * * *"
    }
  ],
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "functions": {
    "api/today.py": {
      "maxDuration": 60,
      "includeFiles": "scripts/build_data.py",
      "excludeFiles": "{node_modules/**,data/**,public/**,notes/**,*.md,.env}"
    }
  }
}
