# Copy to .env for local runs (.env is git-ignored). On Vercel: Settings -> Environment Variables, same names.

# Close API key (read access is enough; the script only reads)
CLOSE_API_KEY=

# GoHighLevel private integration key (the read-only one) and the location id
GHL_API_KEY=
GHL_LOCATION_ID=

# Vercel only: any long random string. Vercel sends it to /api/refresh so nobody else can trigger rebuilds
CRON_SECRET=

# Vercel only: Settings -> Git -> Deploy Hooks -> create one for branch main, paste its URL here
DEPLOY_HOOK_URL=

# Any long random string; goes at the end of the webhook URL added in ROAS: https://<site>/api/roas?k=<this>
ROAS_WEBHOOK_SECRET=

# Any long random string, set once and NEVER change it (it keeps record ids anonymous and stable)
ID_SALT=

# Password for the dashboard's login box (any username works)
DASHBOARD_PASSWORD=

# Set automatically when the Vercel Blob store is connected (Storage tab); don't add by hand.
# BLOB_STORE_ID=   (the SDK then authenticates with Vercel's OIDC token; BLOB_READ_WRITE_TOKEN works too)
